// 1) redéclaration de variable globale
int X;
char X;   // Erreur attendue : X déjà déclarée en global

// 2) conflit nom de fonction / nom de variable globale
int foo;
void foo(void) {  // Erreur attendue : foo en conflit avec une variable globale
}

// 3) conflit entre paramètres et variables locales
void bar(int a, char a) {  
    // Erreur attendue : paramètre « a » déjà déclaré
}

void baz(int p) {
    int p; // Erreur attendue : variable locale « p » en conflit avec un paramètre
}

