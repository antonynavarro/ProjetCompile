char c;      // variable globale de type char
int  i;      // variable globale de type int
int yoloswag;

void foo(void) {
    char  lc; 
    int   li;

    // — Cas valides
    lc = 'A';     // littéral char → char   ✓
    li = 42;      // littéral int  → int    ✓
    li = lc;      // char         → int    ✓

    // — Cas générant warning
    lc = li;      // int          → char   WARNING
    lc = 300;     // littéral int → char   WARNING
}

int main(void) {
    char mc;
    int  mi;

    mc = i;       // int          → char WARNING
    mi = c;       // char         → int    

    return 0;
}

