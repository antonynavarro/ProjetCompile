int main(void) {
    int x;
    int y;
    int w;
    
    // Initialisation des variables de test
    x = 15;
    y = 5;
    
    // Test 1: Utiliser le modulo comme condition (if(!(x%5)))
    putint(1);
    putchar(32);  // espace
    if (!(x % 5)) {  // Devrait être vrai car 15 % 5 = 0
        putint(1);  // Devrait afficher 1 (vrai)
    } else {
        putint(0);
    }
    putchar(10);  // Saut de ligne
    
    // Test 2: Utiliser le résultat d'une division comme condition
    putint(2);
    putchar(32);  // espace
    if (x / y) {  // Devrait être vrai car 15 / 5 = 3
        putint(1);  // Devrait afficher 1 (vrai)
    } else {
        putint(0);
    }
    putchar(10);  // Saut de ligne
    
    // Test 3: Utiliser une addition comme condition
    putint(3);
    putchar(32);  // espace
    if (x + y) {  // Devrait être vrai car 15 + 5 = 20
        putint(1);  // Devrait afficher 1 (vrai)
    } else {
        putint(0);
    }
    putchar(10);  // Saut de ligne
    
    // Test 4: Utiliser une soustraction qui donne zéro comme condition
    putint(4);
    putchar(32);  // espace
    if (x - x) {  // Devrait être faux car 15 - 15 = 0
        putint(0);
    } else {
        putint(1);  // Devrait afficher 1 (faux)
    }
    putchar(10);  // Saut de ligne
    
    // Test 5: Expression arithmétique complexe
    putint(5);
    putchar(32);  // espace
    if ((x + y) % 10) {  // Devrait être vrai car (15 + 5) % 10 = 0 (faux)
        putint(0);
    } else {
        putint(1);  // Devrait afficher 1 (vrai)
    }
    putchar(10);  // Saut de ligne
    
    // Test 6: Expression arithmétique avec un Not devant
    putint(6);
    putchar(32);  // espace
    if (!(x % 3)) {  // Devrait être faux car 15 % 3 = 0, et !(0) = 1 (vrai)
        putint(1);  // Devrait afficher 1 (vrai)
    } else {
        putint(0);
    }
    putchar(10);  // Saut de ligne
    
    // Test 7: Combinaison d'expression arithmétique et comparaison
    putint(7);
    putchar(32);  // espace
    if ((x % 5) == 0 && (y % 2) != 0) {  // Devrait être vrai car (15 % 5 = 0) et (5 % 2 = 1)
        putint(1);  // Devrait afficher 1 (vrai)
    } else {
        putint(0);
    }
    putchar(10);  // Saut de ligne
    
    // Test 8: Combinaison complexe avec opérateur logique OR
    putint(8);
    putchar(32);  // espace
    if ((x % 2) || (y % 2)) {  // Devrait être vrai car (15 % 2 = 1) ou (5 % 2 = 1)
        putint(1);  // Devrait afficher 1 (vrai)
    } else {
        putint(0);
    }
    putchar(10);  // Saut de ligne
    
    // Test 9: La condition if(!(x%5))x=x/5; qu'on nous a demandé d'implémenter
    putint(9);
    putchar(32);  // espace
    putint(x);    // Affiche la valeur de x avant
    putchar(32);  // espace
    if (!(x % 5)) {
        x = x / 5;
    }
    putint(x);    // Affiche la valeur de x après
    putchar(10);  // Saut de ligne
    
    return 0;
}
