int main(void) {
    int a;
    int b;
    a = 5;
    b = 10;

    // --- Basic comparison tests ---
    // Test equal (==)
    if (a == a) {
        putint(1);  // Should print 1
    } else {
        putint(-1);
    }
    
    // Test not equal (!=)
    if (a != b) {
        putint(2);  // Should print 2
    } else {
        putint(-2);
    }
    
    // Test less than (<)
    if (a < b) {
        putint(3);  // Should print 3
    } else {
        putint(-3);
    }
    
    // Test greater than (>)
    if (b > a) {
        putint(4);  // Should print 4
    } else {
        putint(-4);
    }
    
    // Test less than or equal (<=)
    if (a <= a) {
        putint(5);  // Should print 5
    } else {
        putint(-5);
    }
    
    // Test greater than or equal (>=)
    if (b >= b) {
        putint(6);  // Should print 6
    } else {
        putint(-6);
    }
    
    if ((a!=b) && (a==b)){
        putint(7);
    }
    else{
    	putint(-7);
    }
    
    if((a || b)){
    	putint(8);
    }
    else{
    	putint(-8);
    }
    
    if((a && b)){
    	putint(9);
    }

    putchar(10); // newline

    return 0;
}
